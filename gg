    char ip[64];
    cout << "Server IP (127.0.0.1): ";
    cin.getline(ip, 64);
    if (strlen(ip) == 0) {
        strcpy_s(ip, "127.0.0.1");
    }
    
    struct addrinfo hints = {}, *res;
    hints.ai_family = AF_UNSPEC;
    hints.ai_socktype = SOCK_STREAM;
    hints.ai_protocol = IPPROTO_TCP;
    
    int iResult = getaddrinfo(ip, "27015", &hints, &res);
    if (iResult != 0) {
        cout << "getaddrinfo failed: " << iResult << endl;
        WSACleanup();
        return 1;
    }
    
    sock = socket(res->ai_family, res->ai_socktype, res->ai_protocol);
    if (sock == INVALID_SOCKET) {
        cout << "socket failed" << endl;
        freeaddrinfo(res);
        WSACleanup();
        return 1;
    }
    
    iResult = connect(sock, res->ai_addr, (int)res->ai_addrlen);
    freeaddrinfo(res);
    
    if (iResult == SOCKET_ERROR) {
        cout << "connect failed: " << WSAGetLastError() << endl;
        closesocket(sock);
        WSACleanup();
        return 1;
    }
    
    char name[64];
    cout << "Your name: ";
    cin.getline(name, 64);
    send(sock, name, (int)strlen(name), 0);
    
    CreateThread(NULL, 0, Receiver, NULL, 0, NULL);
    
    cout << "Connected! Type /users for list, /exit to quit\n";
    
    char buf[BUF_SIZE];
    
    while (running) {
        cout << "> ";
        cin.getline(buf, BUF_SIZE);
        
        if (strlen(buf) == 0) continue;
        
        if (strcmp(buf, "/exit") == 0) {
            send(sock, buf, (int)strlen(buf), 0);
            running = false;
            break;
        }
        
        ULONGLONG now = GetTickCount64();
        if (now - lastSend >= 500) {
            send(sock, buf, (int)strlen(buf), 0);
            lastSend = now;
        }
        else {
            cout << "[Anti-spam] Wait a bit...\n";
        }
    }
    
    shutdown(sock, SD_SEND);
    closesocket(sock);
    WSACleanup();
    return 0;
}
