        // доступность основных элементов начального экрана
        [Fact]
        public void AccessCheckTest()
        {
            _webDriver.Url = "https://test.webmx.ru";
            const string Title = "Сервис заметок";
            
            IWebElement regButton = _webDriver.FindElement(By.Id("registerTab"));
            Assert.True(regButton.Enabled);
            
            regButton.Click();
            Thread.Sleep(Sleep);
            
            IWebElement logButton = _webDriver.FindElement(By.Id("loginTab"));
