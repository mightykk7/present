// zad15.cpp
#define WIN32_LEAN_AND_MEAN
#include <Windows.h>
#include <winsock2.h>
#include <WS2tcpip.h>
#include <iostream>
#include <ctime>

#pragma comment(lib, "Ws2_32.lib")

using namespace std;

#define MAX_CLIENTS 256
#define BUF_SIZE 512
#define DEFAULT_PORT "27015"

struct Client {
    SOCKET socket;
    char name[64];
    bool connected;
    ULONGLONG lastMsg;
};

Client clients[MAX_CLIENTS];
int clientCount = 0;
CRITICAL_SECTION cs;

void SendToAll(const char* msg, SOCKET except = INVALID_SOCKET) {
    EnterCriticalSection(&cs);
    for (int i = 0; i < MAX_CLIENTS; i++) {
        if (clients[i].connected && clients[i].socket != except) {
            send(clients[i].socket, msg, (int)strlen(msg), 0);
        }
    }
    LeaveCriticalSection(&cs);
}

DWORD WINAPI ClientHandler(LPVOID param) {
    SOCKET sock = (SOCKET)param;
    char buf[BUF_SIZE];
    char name[64] = "Guest";
    
    int res = recv(sock, name, 64, 0);
    if (res > 0) name[res] = '\0';
    
    EnterCriticalSection(&cs);
    for (int i = 0; i < MAX_CLIENTS; i++) {
        if (!clients[i].connected) {
            clients[i].socket = sock;
            strcpy_s(clients[i].name, name);
            clients[i].connected = true;
            clients[i].lastMsg = GetTickCount64();
            clientCount++;
            break;
        }
    }
    LeaveCriticalSection(&cs);
    
    char msg[BUF_SIZE];
    sprintf_s(msg, "[SERVER]: user \"%s\" has joined\n", name);
    cout << msg;
    SendToAll(msg);
    
    while (true) {
        res = recv(sock, buf, BUF_SIZE, 0);
        if (res <= 0) break;
        buf[res] = '\0';
        
        // Убираем \n и \r
        int len = strlen(buf);
        if (len > 0 && buf[len-1] == '\n') buf[len-1] = '\0';
        if (len > 1 && buf[len-2] == '\r') buf[len-2] = '\0';
        
        cout << "[" << name << "]: " << buf << endl;
        
        if (strcmp(buf, "/users") == 0) {
            char list[BUF_SIZE * 2] = "[SERVER]: Active users:\n";
            EnterCriticalSection(&cs);
            for (int i = 0; i < MAX_CLIENTS; i++) {
                if (clients[i].connected) {
                    char line[80];
                    sprintf_s(line, "  - %s\n", clients[i].name);
                    strcat_s(list, line);
                }
            }
            LeaveCriticalSection(&cs);
            send(sock, list, (int)strlen(list), 0);
        }
        else if (strcmp(buf, "/exit") == 0) {
            break;
        }
        else {
            // Поиск себя для проверки спама
            EnterCriticalSection(&cs);
            for (int i = 0; i < MAX_CLIENTS; i++) {
                if (clients[i].socket == sock) {
                    ULONGLONG now = GetTickCount64();
                    if (now - clients[i].lastMsg < 500) {
                        char warn[] = "[SERVER]: Don't spam!\n";
                        send(sock, warn, (int)strlen(warn), 0);
                        LeaveCriticalSection(&cs);
                        continue;
                    }
                    clients[i].lastMsg = now;
                    break;
                }
            }
            LeaveCriticalSection(&cs);
            
            sprintf_s(msg, "[%s]: %s\n", name, buf);
            SendToAll(msg, sock);
        }
    }
    
    EnterCriticalSection(&cs);
    for (int i = 0; i < MAX_CLIENTS; i++) {
        if (clients[i].socket == sock) {
            clients[i].connected = false;
            clientCount--;
            break;
        }
    }
    LeaveCriticalSection(&cs);
    
    sprintf_s(msg, "[SERVER]: user \"%s\" left the chat\n", name);
    cout << msg;
    SendToAll(msg);
    
    closesocket(sock);
    return 0;
}

int main() {
    WSADATA wsa;
    WSAStartup(MAKEWORD(2, 2), &wsa);
    InitializeCriticalSection(&cs);
    
    for (int i = 0; i < MAX_CLIENTS; i++) clients[i].connected = false;
    
    struct addrinfo hints = {}, *res;
    hints.ai_family = AF_INET;
    hints.ai_socktype = SOCK_STREAM;
    hints.ai_protocol = IPPROTO_TCP;
    hints.ai_flags = AI_PASSIVE;
    
    getaddrinfo(NULL, DEFAULT_PORT, &hints, &res);
    SOCKET listenSock = socket(res->ai_family, res->ai_socktype, res->ai_protocol);
    bind(listenSock, res->ai_addr, (int)res->ai_addrlen);
    freeaddrinfo(res);
    listen(listenSock, SOMAXCONN);
    
    cout << "Server started on port " << DEFAULT_PORT << endl;
    
    while (true) {
        SOCKET client = accept(listenSock, NULL, NULL);
        if (client != INVALID_SOCKET) {
            CreateThread(NULL, 0, ClientHandler, (LPVOID)client, 0, NULL);
        }
    }
    
    DeleteCriticalSection(&cs);
    closesocket(listenSock);
    WSACleanup();
    return 0;
}
