#include <iostream>
#include <Windows.h>
#include <ctime>

#define MAX_CLIENTS 20
#define CLUB_CAPACITY 4

/**
* Структура записи о посетителе
*/
struct ClientRecord {
    DWORD threadId; // Идентификатор потока
    DWORD arriveTick; // Время прихода посетителя
    DWORD startTick; // Время начала обслуживания
    DWORD endTick; // Время завершения обслуживания
    BOOL served; // Был ли обслужен
    BOOL timeout; // Ушел ли по таймауту
};

/**
* Состояние компьютерного клуба
*/
struct ClubState {
    ClientRecord clients[MAX_CLIENTS]; // Информация о посетителях
    LONG currentVisitors; // Текущее число занятых мест
    LONG maxVisitors; // Максимум одновременно занятых мест
    LONG servedCount;
    LONG timeoutCount; // Количество ушедших по таймауту
};

ClubState club;
CRITICAL_SECTION cs;
bool useSemaphore = false;
HANDLE hSemaphore;
HANDLE hThreads[MAX_CLIENTS];

DWORD WINAPI ClientThread(LPVOID param) {
    ClientRecord* client = (ClientRecord*)param;
    
    // Фиксируем время прихода
    client->arriveTick = GetTickCount();
    
    // Сохраняем информацию в общую структуру
    EnterCriticalSection(&cs);
    int clientIndex = client->threadId - 1;
    club.clients[clientIndex] = *client;
    LeaveCriticalSection(&cs);
    
    DWORD waitResult;
    
    // Пытаемся получить доступ к компьютеру
    if (useSemaphore) {
        waitResult = WaitForSingleObject(hSemaphore, 3000);
    }
    else {
        waitResult = WAIT_OBJECT_0; // Без семафора всегда успешно
    }
    
    if (waitResult == WAIT_OBJECT_0) {
        // Получили доступ - начинаем обслуживание
        client->startTick = GetTickCount();
        
        EnterCriticalSection(&cs);
        club.currentVisitors++;
        if (club.maxVisitors < club.currentVisitors) {
            club.maxVisitors = club.currentVisitors;
        }
        club.clients[clientIndex].startTick = client->startTick;
        LeaveCriticalSection(&cs);
        
        // Работа за компьютером (2000-5000 мс)
        int workTime = (rand() % (5000 - 2000 + 1)) + 2000;
        Sleep(workTime);
        
        // Завершение обслуживания
        client->endTick = GetTickCount();
        
        if (useSemaphore) {
            ReleaseSemaphore(hSemaphore, 1, NULL);
        }
        
        EnterCriticalSection(&cs);
        client->served = TRUE;
        client->timeout = FALSE;
        club.servedCount++;
        club.currentVisitors--;
        club.clients[clientIndex] = *client;
        LeaveCriticalSection(&cs);
    }
    else {
        // Таймаут - ушел без обслуживания
        EnterCriticalSection(&cs);
        client->served = FALSE;
        client->timeout = TRUE;
        club.timeoutCount++;
        club.clients[clientIndex] = *client;
        LeaveCriticalSection(&cs);
    }
    
    return 0;
}

DWORD WINAPI ObserverThread(LPVOID param) {
    HANDLE* clientThreads = (HANDLE*)param;
    BOOL allFinished = FALSE;
    
    while (!allFinished) {
        // Проверяем, завершились ли все потоки
        DWORD waitResult = WaitForMultipleObjects(MAX_CLIENTS, clientThreads, TRUE, 500);
        
        if (waitResult == WAIT_TIMEOUT) {
            // Не все потоки завершены - выводим состояние
            EnterCriticalSection(&cs);
            std::cout << "\rЗанято: " << club.currentVisitors
                << " | Обслужено: " << club.servedCount
                << " | Таймауты: " << club.timeoutCount << "   " << std::flush;
            LeaveCriticalSection(&cs);
        }
        else {
            // Все потоки завершены
            allFinished = TRUE;
        }
    }
    
    return 0;
}

int main()
{
    setlocale(0, "rus");
    srand(GetTickCount());
    
    std::cout << "Использовать семафоры?\n1 - использовать / 2 - не использовать\n";
    int otvet; 
    std::cin >> otvet;
    
    if (otvet == 1) {
        hSemaphore = CreateSemaphore(NULL, CLUB_CAPACITY, CLUB_CAPACITY, L"ClubSemaphore");
        if (hSemaphore == NULL) {
            std::cerr << "Ошибка создания семафора: " << GetLastError() << std::endl;
            return GetLastError();
        }
        useSemaphore = true;
        std::cout << "Семафор создан (макс. " << CLUB_CAPACITY << " мест)" << std::endl;
    }
    else {
        useSemaphore = false;
        std::cout << "Работа без семафора" << std::endl;
    }
    
    InitializeCriticalSection(&cs);
    
    // Инициализация состояния клуба
    club.currentVisitors = 0;
    club.maxVisitors = 0;
    club.servedCount = 0;
    club.timeoutCount = 0;
    
    // Инициализация массива клиентов
    for (int i = 0; i < MAX_CLIENTS; i++) {
        club.clients[i].threadId = i + 1;
        club.clients[i].arriveTick = 0;
        club.clients[i].startTick = 0;
        club.clients[i].endTick = 0;
        club.clients[i].served = FALSE;
        club.clients[i].timeout = FALSE;
    }
    
    DWORD IDThreads[MAX_CLIENTS];
    
    std::cout << "Создание потоков посетителей..." << std::endl;
    
    // Создаем потоки посетителей
    for (int i = 0; i < MAX_CLIENTS; i++) {
        hThreads[i] = CreateThread(NULL, 0, ClientThread, &club.clients[i], NULL, &IDThreads[i]);
        if (hThreads[i] == NULL) {
            std::cerr << "Ошибка создания потока " << i << ": " << GetLastError() << std::endl;
            return GetLastError();
        }
        
        // Устанавливаем приоритеты согласно заданию
        if (i >= 0 && i <= 7) {
            SetThreadPriority(hThreads[i], THREAD_PRIORITY_NORMAL);
        }
        else if (i >= 8 && i <= 15) {
            SetThreadPriority(hThreads[i], THREAD_PRIORITY_BELOW_NORMAL);
        }
        else if (i >= 16 && i <= 19) {
            SetThreadPriority(hThreads[i], THREAD_PRIORITY_HIGHEST);
        }
        
        // Небольшая задержка между созданиями потоков для более реалистичной симуляции
        Sleep(rand() % 100);
    }
    
    // Создаем поток наблюдателя
    std::cout << "Создание потока наблюдателя..." << std::endl;
    HANDLE hObsThread = CreateThread(NULL, 0, ObserverThread, hThreads, NULL, NULL);
    if (hObsThread == NULL) {
        std::cerr << "Ошибка создания потока наблюдателя: " << GetLastError() << std::endl;
        return GetLastError();
    }
    
    SetThreadPriority(hObsThread, THREAD_PRIORITY_LOWEST);
    
    // Ждем завершения всех потоков посетителей
    std::cout << "Ожидание завершения всех потоков..." << std::endl;
    WaitForMultipleObjects(MAX_CLIENTS, hThreads, TRUE, INFINITE);
    
    // Ждем завершения наблюдателя
    WaitForSingleObject(hObsThread, INFINITE);
    
    // Выводим итоговую статистику
    std::cout << "\n\n========================================" << std::endl;
    std::cout << "              ИТОГОВАЯ СТАТИСТИКА" << std::endl;
    std::cout << "========================================" << std::endl;
    std::cout << "Максимум занятых мест: " << club.maxVisitors << std::endl;
    std::cout << "Всего обслужено: " << club.servedCount << std::endl;
    std::cout << "Ушло по таймауту: " << club.timeoutCount << std::endl;
    
    // Считаем среднее время ожидания и обслуживания
    double totalWaitTime = 0;
    double totalServiceTime = 0;
    int served = 0;
    int timeoutClients = 0;
    
    std::cout << "\n--- Подробная информация о посетителях ---" << std::endl;
    std::cout << "ID\tПриоритет\tСтатус\t\tВремя ожидания(сек)\tВремя работы(сек)" << std::endl;
    std::cout << "----------------------------------------------------------------" << std::endl;
    
    for (int i = 0; i < MAX_CLIENTS; i++) {
        const char* priority;
        if (i >= 0 && i <= 7) priority = "NORMAL";
        else if (i >= 8 && i <= 15) priority = "BELOW_NORMAL";
        else priority = "HIGHEST";
        
        if (club.clients[i].served) {
            double waitTime = (club.clients[i].startTick - club.clients[i].arriveTick) / 1000.0;
            double serviceTime = (club.clients[i].endTick - club.clients[i].startTick) / 1000.0;
            totalWaitTime += waitTime;
            totalServiceTime += serviceTime;
            served++;
            
            std::cout << club.clients[i].threadId << "\t" << priority << "\t\tОБСЛУЖЕН\t"
                << waitTime << "\t\t\t" << serviceTime << std::endl;
        }
        else if (club.clients[i].timeout) {
            totalWaitTime += 3.0; // Ждал 3 секунды
            timeoutClients++;
            
            std::cout << club.clients[i].threadId << "\t" << priority << "\t\tТАЙМАУТ\t\t"
                << "3.00" << "\t\t\t---" << std::endl;
        }
    }
    
    std::cout << "\n========================================" << std::endl;
    if (MAX_CLIENTS > 0) {
        std::cout << "Среднее время ожидания: " << totalWaitTime / MAX_CLIENTS << " сек" << std::endl;
    }
    if (served > 0) {
        std::cout << "Среднее время обслуживания: " << totalServiceTime / served << " сек" << std::endl;
    }
    
    // Выводим список потоков, не дождавшихся места
    if (timeoutClients > 0) {
        std::cout << "\n--- Посетители, не дождавшиеся места (ID) ---" << std::endl;
        for (int i = 0; i < MAX_CLIENTS; i++) {
            if (club.clients[i].timeout) {
                std::cout << club.clients[i].threadId << " ";
            }
        }
        std::cout << std::endl;
    }
    
    std::cout << "\nНажмите любую клавишу для выхода..." << std::endl;
    
    // Закрываем дескрипторы
    for (int i = 0; i < MAX_CLIENTS; i++) {
        CloseHandle(hThreads[i]);
    }
    CloseHandle(hObsThread);
    
    if (useSemaphore) {
        CloseHandle(hSemaphore);
    }
    
    DeleteCriticalSection(&cs);
    
    system("pause");
    return 0;
}
