//Рассчёт урона игрока
double CalcPlayerDamage(int baseDamage, int resist) {
    return baseDamage * (100.0 - resist) / 100.0;
}
//Рассчёт урона босса
double CalcBossDamage(int baseDamage, int defense) {
    return baseDamage * (100.0 - defense) / 100.0;
}
//Рассчёт специально атаки босса
double CalcSpecialDamage(int base, int playerCount) {
    if (playerCount <= 1)
        return base;
    return base * (1.0 - 0.5 * (playerCount - 1));
}
void Print(const char* msg) {
